{
  "name": "tcules-website-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens:check": "node scripts/tokens-check.mjs",
    "specimens:check": "node scripts/specimens-check.mjs",
    "classes:check": "node scripts/classes-check.mjs",
    "corpus:check": "node --no-warnings scripts/corpus-check.mjs",
    "corpus:assets": "node scripts/corpus-assets.mjs",
    "corpus:census": "node --no-warnings scripts/corpus-census.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "aria:check": "node scripts/aria-check.mjs",
    "kinds:check": "node --no-warnings scripts/kinds-check.mjs",
    "shots": "node scripts/shots.mjs",
    "fold:check": "node scripts/fold-check.mjs",
    "design:brief": "node scripts/design-brief.mjs",
    "design:check": "node scripts/design-brief.mjs --check",
    "vocabulary": "node scripts/design-brief.mjs --vocabulary > docs/vocabulary.md",
    "guide:dist": "node scripts/guide-dist.mjs",
    "ds:build": "npm run vocabulary && node scripts/ds-artifact/build.mjs",
    "ds:check": "node scripts/ds-artifact/check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run tokens:check && npm run classes:check && npm run specimens:check && npm run design:check && npm run photos:check && npm run corpus:check && npm run corpus:assets -- --check && npm run placeholders -- --check && npm run illustrations:situations -- --check && npm run illustrations:engagement -- --check && npm run illustrations:reasons -- --check && npm run illustrations:claims -- --check && npm run decisions",
    "format": "prettier --write .",
    "texture": "node scripts/texture.mjs",
    "photos:tone": "node scripts/photos-tone.mjs",
    "photos:derive": "node scripts/photos-derive.mjs",
    "photos:check": "node scripts/photos-tone.mjs --check && node scripts/photos-derive.mjs --check",
    "illustrations:phone": "node scripts/illustrations-phone.mjs",
    "illustrations": "node scripts/illustrations/build.mjs",
    "illustrations:situations": "node scripts/illustrations/situations.mjs",
    "decisions": "node scripts/decisions.mjs",
    "illustrations:engagement": "node scripts/illustrations/engagement.mjs",
    "illustrations:reasons": "node scripts/illustrations/reasons.mjs",
    "illustrations:claims": "node scripts/illustrations/claims.mjs",
    "sketch:frames": "node scripts/sketch-frames.mjs"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
