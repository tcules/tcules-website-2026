# Required: the only CMS GraphQL endpoint used by the website.
NEW_CMS_GRAPHQL_URL=https://tcules-cms-2026-production.up.railway.app/graphql

# Cloudflare Turnstile. Set the secret in the frontend server's environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACskTwK0uXlzaHar
TURNSTILE_EXPECTED_HOSTNAME=www.tcules.com
TURNSTILE_SECRET_KEY=

# Match the Strapi Admin webhook Authorization header. Use at least 32 random characters.
CMS_REVALIDATION_SECRET=
