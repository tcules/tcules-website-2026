# Optional override. The production Strapi endpoint is the application default.
STRAPI_GRAPHQL_URL=https://tcules-server-production.up.railway.app/graphql

# /case-studies/{slug} reads the new production CMS independently of other page families.
# Both values are server-only. The URL below is also the default; public reads need no token.
STRAPI_CASE_STUDY_GRAPHQL_URL=https://tcules-cms-2026-production.up.railway.app/graphql
